{
  "name": "luigi-picture-poker",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Luigi's Picture Poker — poker à symboles Mario, écran scindé façon DS avec Luigi en 3D (three.js), jouable sur iPhone et Android (Capacitor / PWA).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/game/*.test.js",
    "sync": "vite build && cap sync",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios",
    "icons": "npx @capacitor/assets generate --android --ios --iconBackgroundColor '#06301F' --iconBackgroundColorDark '#06301F' --splashBackgroundColor '#03170F' --splashBackgroundColorDark '#03170F'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
